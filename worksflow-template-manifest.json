{
  "schemaVersion": "template-manifest/v1",
  "templateId": "go-kratos-api",
  "displayName": "Go Kratos API",
  "version": "0.2.0",
  "services": [
    {
      "id": "api",
      "kind": "api",
      "rootPath": "."
    }
  ],
  "toolchains": [
    {
      "name": "go",
      "version": "1.25.12",
      "image": "golang:1.25-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58"
    }
  ],
  "commands": {
    "install": {
      "workingDirectory": ".",
      "argv": ["go", "mod", "download"]
    },
    "lint": {
      "workingDirectory": ".",
      "argv": ["go", "vet", "./..."]
    },
    "typecheck": {
      "workingDirectory": ".",
      "argv": ["go", "test", "-run", "^$", "./..."]
    },
    "test": {
      "workingDirectory": ".",
      "argv": ["go", "test", "./..."]
    },
    "build": {
      "workingDirectory": ".",
      "argv": ["go", "build", "-trimpath", "-o", "bin/server", "./cmd/server"]
    },
    "start": {
      "workingDirectory": ".",
      "argv": ["./bin/server"]
    }
  },
  "ports": [
    {
      "name": "api-http",
      "serviceId": "api",
      "number": 8000,
      "protocol": "http",
      "exposure": "preview"
    }
  ],
  "healthChecks": [
    {
      "id": "api-ready",
      "serviceId": "api",
      "portName": "api-http",
      "path": "/healthz"
    }
  ],
  "buildOutputs": [
    {
      "serviceId": "api",
      "path": "bin/server"
    }
  ],
  "extensionPaths": ["api", "cmd", "configs", "internal"],
  "protectedPaths": [
    "Dockerfile",
    "go.mod",
    "go.sum",
    "worksflow-template-manifest.json"
  ],
  "environmentSchema": [
    {
      "name": "PORT",
      "required": false,
      "secret": false,
      "description": "HTTP port exposed by the Kratos service.",
      "default": "8000"
    }
  ],
  "lockfiles": [
    {
      "path": "go.sum",
      "digest": "sha256:8d4da4a1cb16d312b8a827fba9331d8648d22ed3b356f7788482b1ee9672b989",
      "registry": "https://proxy.golang.org"
    }
  ],
  "profileDigest": "sha256:9d884e5136507fd5a7b7e2410878b0f31f524c4faf2ca39625a06ed48f996672"
}
